# 常规
HOST=127.0.0.1
PORT=8808
SUPERUSERS=["12345"]
NICKNAME=["bot"]
COMMAND_START=["."]
APSCHEDULER_AUTOSTART=true
APSCHEDULER_CONFIG={"apscheduler.timezone": "Asia/Shanghai"}

# Discord
# https://github.com/nonebot/adapter-discord
# pip3 install nonebot-adapter-discord
# DRIVER=~httpx+~websockets
# 获取 Discord token
# https://gist.github.com/MarvNC/e601f3603df22f36ebd3102c501116c6
# DISCORD_BOTS='
# [
#   {
#     "token": "xxx",
#     "intent": {
#       "guild_messages": true,
#       "direct_messages": true
#     },
#     "application_commands": {"*": ["*"]}
#   }
# ]
# '
# application_commands的{"*": ["*"]}代表将全部应用命令注册为全局应用命令
# {"admin": ["123", "456"]}则代表将admin命令注册为id是123、456服务器的局部命令，其余命令不注册
